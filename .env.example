# Copier ce fichier en .env (non versionné) et remplir les valeurs.
# .env est listé comme asset dans pubspec.yaml et chargé au démarrage via flutter_dotenv.

# Supabase — clés publiques (anon key uniquement, JAMAIS le service_role)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# RevenueCat — public SDK key (différente iOS / Android)
REVENUECAT_PUBLIC_KEY_IOS=appl_xxx
REVENUECAT_PUBLIC_KEY_ANDROID=goog_xxx

# Cardmarket — utilisé uniquement côté Edge Functions, pas dans le client.
# Laisser vide ici, configuré dans les secrets Supabase.

# Service role — UNIQUEMENT pour les scripts locaux (import catalogue, migrations
# manuelles). NE JAMAIS committer cette valeur. NE JAMAIS l'embarquer dans le
# bundle Flutter. La récupérer dans Supabase Dashboard → Settings → API.
SUPABASE_SERVICE_ROLE_KEY=
